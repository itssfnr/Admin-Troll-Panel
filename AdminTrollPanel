-- Temporäre Positionsspeicher:
-- [Player] = { [Slot] = CFrame }
local savedPositions = {}

local function getPlayer(name)
	if typeof(name) ~= "string" then
		return nil
	end

	name = name:lower()

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Name:lower() == name
			or plr.DisplayName:lower() == name then
			return plr
		end
	end

	return nil
end

local function getRoot(plr)
	if not plr or not plr.Character then
		return nil
	end

	return plr.Character:FindFirstChild("HumanoidRootPart")
end

Remote.OnServerEvent:Connect(function(sender, command, data)

	if typeof(command) ~= "string" then
		return
	end

	data = typeof(data) == "table" and data or {}

	--------------------------------------------------------
	-- SAVE POSITION
	--------------------------------------------------------

	if command == "SavePosition" then

		local slot = tonumber(data.Slot)

		if not slot or slot < 1 or slot > 5 then
			return
		end

		local root = getRoot(sender)

		if root then

			savedPositions[sender] =
				savedPositions[sender] or {}

			savedPositions[sender][slot] =
				root.CFrame

			Remote:FireClient(sender, "PositionSaved", {
				Slot = slot
			})
		end

		return
	end

	--------------------------------------------------------
	-- TELEPORT TO SAVED POSITION
	--------------------------------------------------------

	if command == "TeleportPosition" then

		local slot = tonumber(data.Slot)

		if not slot or slot < 1 or slot > 5 then
			return
		end

		local saved =
			savedPositions[sender]

		if not saved then
			return
		end

		local position =
			saved[slot]

		if not position then
			return
		end

		local root = getRoot(sender)

		if root then
			root.CFrame =
				position + Vector3.new(0,3,0)
		end

		return
	end

	--------------------------------------------------------
	-- DELETE POSITION
	--------------------------------------------------------

	if command == "ClearPosition" then

		local slot = tonumber(data.Slot)

		if not slot or slot < 1 or slot > 5 then
			return
		end

		if savedPositions[sender] then
			savedPositions[sender][slot] = nil
		end

		Remote:FireClient(sender, "PositionCleared", {
			Slot = slot
		})

		return
	end

	--------------------------------------------------------
	-- SERVER MESSAGE
	--------------------------------------------------------

	if command == "Message" then

		local message =
			tostring(data.Message or "")

		if message == "" then
			return
		end

		message =
			message:sub(1,200)

		Remote:FireAllClients(
			"ServerMessage",
			{
				Message = message,
				From = sender.DisplayName
			}
		)

		return
	end

	--------------------------------------------------------
	-- TARGET
	--------------------------------------------------------

	local target =
		getPlayer(data.Target)

	if not target then
		return
	end

	--------------------------------------------------------
	-- KILL
	--------------------------------------------------------

	if command == "Kill" then

		local character =
			target.Character

		if character then

			local humanoid =
				character:FindFirstChildOfClass(
					"Humanoid"
				)

			if humanoid then
				humanoid.Health = 0
			end
		end

	--------------------------------------------------------
	-- KICK
	--------------------------------------------------------

	elseif command == "Kick" then

		if target ~= sender then
			target:Kick(
				"Du wurdest aus dem Server gekickt."
			)
		end

	--------------------------------------------------------
	-- RESPAWN
	--------------------------------------------------------

	elseif command == "Respawn" then

		target:LoadCharacter()

	--------------------------------------------------------
	-- FIRE
	--------------------------------------------------------

	elseif command == "Fire" then

		local character =
			target.Character

		if character then

			local oldFire =
				character:FindFirstChild(
					"TrollFire"
				)

			if oldFire then
				oldFire:Destroy()
				return
			end

			local fire =
				Instance.new("Fire")

			fire.Name =
				"TrollFire"

			fire.Heat = 10
			fire.Size = 8
			fire.Parent = character

			task.delay(10,function()

				if fire and fire.Parent then
					fire:Destroy()
				end

			end)
		end

	--------------------------------------------------------
	-- JUMPSCARE
	--------------------------------------------------------

	elseif command == "Jumpscare" then

		Remote:FireClient(
			target,
			"Jumpscare"
		)

	end
end)

