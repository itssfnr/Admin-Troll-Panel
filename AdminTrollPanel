--========================================================
-- FPS COUNTER
--========================================================

local frames = 0
local fps = 60
local lastFPSUpdate = os.clock()

RunService.RenderStepped:Connect(function()

	frames += 1

	local now = os.clock()

	if now - lastFPSUpdate >= 0.5 then

		fps = math.floor(
			frames / (now - lastFPSUpdate)
		)

		frames = 0
		lastFPSUpdate = now

		fpsText.Text = tostring(fps)

		local percentage = math.clamp(fps / 144, 0, 1)

		tween(
			fpsFill,
			{Size = UDim2.new(percentage, 0, 1, 0)},
			0.15
		)

		if fps >= 60 then

			fpsText.TextColor3 = COLORS.GREEN
			fpsFill.BackgroundColor3 = COLORS.GREEN

		elseif fps >= 30 then

			fpsText.TextColor3 = COLORS.ORANGE
			fpsFill.BackgroundColor3 = COLORS.ORANGE

		else

			fpsText.TextColor3 = COLORS.RED
			fpsFill.BackgroundColor3 = COLORS.RED

		end
	end
end)

