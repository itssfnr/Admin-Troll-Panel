------------------------------------------------------------
-- LOCAL KILL
------------------------------------------------------------

local function localKill(target)

	if not target or not target.Character then
		return
	end

	local humanoid =
		target.Character:FindFirstChildOfClass("Humanoid")

	if humanoid then

		-- Only affects what this client can control/observe.
		-- Server-authoritative kill requires a RemoteEvent.
		humanoid.Health = 0

	end
end

------------------------------------------------------------
-- FIRE EFFECT
------------------------------------------------------------

local function firePlayer(target)

	if not target or not target.Character then
		return
	end

	local character = target.Character

	local oldFire =
		character:FindFirstChild("TrollFire")

	if oldFire then
		oldFire:Destroy()
		return
	end

	local fire = Instance.new("Fire")

	fire.Name = "TrollFire"
	fire.Heat = 10
	fire.Size = 8
	fire.Parent = character

	task.delay(10,function()

		if fire and fire.Parent then
			fire:Destroy()
		end

	end)
end

