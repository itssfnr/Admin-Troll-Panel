		},
		0.35
	)

	tween(
		bar,
		{
			BackgroundTransparency = 1
		},
		0.35
	)

	tween(
		percent,
		{
			TextTransparency = 1
		},
		0.35
	)

	task.wait(0.5)

	loading:Destroy()

	main.Visible = true

	main.Size =
		UDim2.fromOffset(680, 490)

	tween(
		main,
		{
			Size = UDim2.fromOffset(760,555)
		},
		0.4,
		Enum.EasingStyle.Back
	)

	notify(
		"⚡ Admin panel ready!",
		PURPLE
	)

	playSound("Success", 0.25, 1.2)

end)

