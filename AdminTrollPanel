local function textButton(parent, text, x, y, w, h, color)

	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(w, h)
	b.Position = UDim2.fromOffset(x, y)
	b.BackgroundColor3 = color or COLORS.CARD2
	b.BorderSizePixel = 0
	b.Text = text
	b.TextColor3 = COLORS.TEXT
	b.TextSize = 11
	b.Font = Enum.Font.GothamBold
	b.AutoButtonColor = false
	b.ZIndex = 20
	b.Parent = parent

	corner(b, 10)
	stroke(b, Color3.fromRGB(100, 105, 140), 0.7, 1)

	local normal = b.BackgroundColor3

	b.MouseEnter:Connect(function()

		tween(b, {
			BackgroundColor3 = color == COLORS.RED and Color3.fromRGB(255, 85, 105)
				or color == COLORS.GREEN and Color3.fromRGB(70, 225, 135)
				or color == COLORS.BLUE and Color3.fromRGB(90, 165, 255)
				or Color3.fromRGB(42, 46, 66)
		}, 0.12)

	end)

	b.MouseLeave:Connect(function()
		tween(b, {
			BackgroundColor3 = normal
		}, 0.12)
	end)

	b.MouseButton1Click:Connect(function()
		sound(0.12, 1.05)
	end)

	return b
end

local function inputBox(parent, placeholder, value, x, y, w, h)

	local box = Instance.new("TextBox")
	box.Size = UDim2.fromOffset(w, h)
	box.Position = UDim2.fromOffset(x, y)
	box.BackgroundColor3 = Color3.fromRGB(13, 16, 25)
	box.BorderSizePixel = 0
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = COLORS.SUBTEXT
	box.Text = value or ""
	box.TextColor3 = COLORS.TEXT
	box.TextSize = 11
	box.Font = Enum.Font.Gotham
	box.ClearTextOnFocus = false
	box.ZIndex = 20
	box.Parent = parent

	corner(box, 10)

	local s = stroke(box, Color3.fromRGB(75, 80, 110), 0.45, 1)

	box.Focused:Connect(function()
		tween(s, {
			Color = COLORS.PURPLE,
			Transparency = 0
		}, 0.15)
	end)

	box.FocusLost:Connect(function()
		tween(s, {
			Color = Color3.fromRGB(75, 80, 110),
			Transparency = 0.45
		}, 0.15)
	end)

	return box
end

