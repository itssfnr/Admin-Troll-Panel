-- INSTALL CLIENT AUTOMATICALLY
------------------------------------------------------------

local function install(player)

	local playerScripts =
		player:WaitForChild(
			"PlayerScripts"
		)

	local old =
		playerScripts:
		FindFirstChild(
			"OneScriptAdminClient"
		)

	if old then
		old:Destroy()
	end

	local client =
		Instance.new(
			"LocalScript"
		)

	client.Name =
		"OneScriptAdminClient"

	client.Source =
		ClientSource

	client.Parent =
		playerScripts
end

Players.PlayerAdded:Connect(function(player)

	task.spawn(function()
		install(player)
	end)

end)

for _,player in ipairs(
	Players:GetPlayers()
) do

	task.spawn(function()
		install(player)
	end)

end

